---
import Base from '../layouts/Base.astro';
import { base, issuesUrl, repoUrl } from '../site';

const title = 'Terms of use · XMarks';
const description = 'The plain-English terms for using the free, open-source XMarks extension and this website.';
const updated = '26 October 2026';
const licenseUrl = `${repoUrl}/blob/master/LICENSE`;
---

<Base title={title} description={description} path="terms/">
  <article class="policy container">
    <header>
      <h1 class="section-title">Terms of use</h1>
      <p class="updated">Last updated {updated}</p>
    </header>

    <p class="lede">
      XMarks is a free Chrome extension that keeps your X bookmarks in a library in your browser. By installing or using it,
      you agree to the short terms below. They are written to be read.
    </p>

    <section>
      <h2>Using XMarks</h2>
      <p>
        XMarks is free and open source, released under the
        <a href={licenseUrl} target="_blank" rel="noopener noreferrer">MIT License</a>. You can use, copy, change and share
        it under that license. If these terms and the license ever disagree about the code, the license wins.
      </p>
    </section>

    <section>
      <h2>Your content and X</h2>
      <p>
        The posts you save belong to their authors and to X, not to XMarks. You are responsible for what you save, how you
        use it, and for following <a href="https://x.com/en/tos" target="_blank" rel="noopener noreferrer">X’s terms</a>
        while you use X.
      </p>
      <p>
        XMarks is an independent project. It is not affiliated with, endorsed by or sponsored by X Corp. “X” and “Twitter”
        belong to their owners.
      </p>
    </section>

    <section>
      <h2>Your data stays on your device</h2>
      <p>
        There is no XMarks account and no XMarks server. Your library lives in your browser, and you can export it or delete
        it whenever you like. What the extension stores and the few times it uses the network are listed in the
        <a href={`${base}privacy/`}>privacy policy</a>.
      </p>
    </section>

    <section>
      <h2>No warranty</h2>
      <p>
        XMarks is provided “as is”, without warranty of any kind, as the MIT License says. We try to make it work well, but
        we can’t promise it will be free of bugs or always available.
      </p>
      <p>
        X can change its site at any time, and that can break saving, syncing or other features until XMarks is updated. We
        may also change or stop working on XMarks.
      </p>
      <p>
        To the extent the law allows, the authors are not liable for any loss or damage that comes from using XMarks,
        including lost or missing bookmarks. Export your library now and then if it matters to you.
      </p>
    </section>

    <section>
      <h2>Changes to these terms</h2>
      <p>
        If these terms change, the new version will be posted here with a new date. Using XMarks after that means you accept
        the updated terms.
      </p>
    </section>

    <section>
      <h2>Contact</h2>
      <p>
        Questions? <a href={issuesUrl} target="_blank" rel="noopener noreferrer">Open an issue on GitHub</a>.
      </p>
    </section>
  </article>
</Base>

<style>
  .policy {
    max-width: 760px;
    padding-top: 48px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    font-size: 17px;
    line-height: 1.6;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .updated {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .policy .lede {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    color: var(--text);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h2 {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: var(--track-m);
  }

  p,
  ul,
  dl {
    margin: 0;
    color: var(--muted);
  }

  ul {
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  strong,
  dt {
    color: var(--text);
    font-weight: 700;
  }

  dd {
    margin: 2px 0 14px;
  }

  a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .policy {
      padding-top: 24px;
    }
  }
</style>
