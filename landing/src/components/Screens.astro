---
import { base, storeUrl } from '../site';

// A working copy of XMarks to play with (see scripts/sandbox.ts). Parody
// accounts from store-assets/demo-library.mjs, avatars from its fixtures.
const categories = [
  { id: 'memes', name: 'Memes', color: '#ffd400' },
  { id: 'dev', name: 'Dev', color: '#1d9bf0' },
  { id: 'design', name: 'Design', color: '#f91880' },
  { id: 'recipes', name: 'Recipes', color: '#00ba7c' },
  { id: 'later', name: 'Read later (lol)', color: '#ff7a00' },
];

const timeline = [
  { id: 't1', name: 'definitely not MJ', handle: 'heehee_official', av: 'mj', time: '2h', text: 'hehe' },
  { id: 't2', name: 'rubber duck (senior engineer)', handle: 'rubberduckdev', av: 'duck', time: '3h', text: 'explained my bug to a rubber duck for 20 minutes. the duck has now been promoted to senior engineer' },
  { id: 't3', name: 'Hawkins Power & Light', handle: 'hawkins_power_co', av: 'hawkins', time: '5h', text: 'we are aware of the lights flickering on Maple St again. we checked the wiring. the wiring is fine. please stop calling' },
  { id: 't4', name: 'Kevin’s famous chili', handle: 'kevins_famous_chili', av: 'kevin', time: '8h', text: 'the trick is to undercook the onions. bookmarking this so I never spill it again' },
  { id: 't5', name: '011', handle: 'eggo_enjoyer', av: 'eleven', time: '11h', text: 'Mike.' },
];

const library = [
  { id: 'l1', name: 'one does not simply', handle: 'onedoesnotsimply', av: 'ring', time: '', text: 'one does not simply merge to main on a friday', cat: 'dev', note: 'print this and hang it in the office', ago: 4 },
  { id: 'l2', name: 'not Remy (rat, chef)', handle: 'anyone_can_cook', av: 'remy', time: '', text: 'anyone can cook. 72 hours of proofing, 42 seconds of video. please do not tell the health inspector', cat: 'recipes', note: 'making this sunday (for real this time)', ago: 6 },
  { id: 'l3', name: 'Kowalski (analysis)', handle: 'kowalski_analysis', av: 'kowalski', time: '', text: 'skipper asked for an analysis of our bookmark habits. it’s not good, skipper', cat: 'memes', note: 'sending this to my therapist', ago: 8 },
  { id: 'l4', name: 'doge', handle: 'much_bookmark', av: 'doge', time: '', text: 'such tier list. very ranking. wow', cat: 'memes', note: '', ago: 10 },
  { id: 'l5', name: 'Pam from reception', handle: 'same_picture_pam', av: 'pam', time: '', text: 'corporate needs you to find the differences between “saved” and “read”. they’re the same picture.', cat: 'design', note: '', ago: 70 },
  { id: 'l6', name: 'Mochi (cat)', handle: 'mochi_commits', av: 'cat', time: '', text: 'walked across the keyboard and fixed the flaky test. no notes. treats accepted', cat: 'dev', note: 'hire this cat', ago: 96 },
  { id: 'l7', name: 'cookie enjoyer', handle: 'om_nom_nom', av: 'cookie', time: '', text: 'me at 2am: bookmarks a 47-part thread on medieval bread. me 6 months later: has not baked the bread', cat: 'later', note: 'me. this is me.', ago: 30 },
].sort((a, b) => a.ago - b.ago);

// Generic stroke icons for X's action bar, as in the hero.
const icons = {
  reply: 'M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-8l-5 4v-4H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
  repost: 'M17 3l3 3-3 3M4 11V9a3 3 0 0 1 3-3h13M7 21l-3-3 3-3M20 13v2a3 3 0 0 1-3 3H4',
  like: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
  views: 'M5 20V11M10 20V5M15 20v-7M20 20v-4',
  bookmark: 'M6 3h12v18l-6-4.5L6 21z',
  share: 'M12 3v12M7 8l5-5 5 5M5 14v6h14v-6',
};
const counts: Record<string, string[]> = {
  t1: ['8.1K', '61K', '402K', '12M'],
  t2: ['214', '3.9K', '41K', '1.2M'],
  t3: ['1.8K', '702', '9.4K', '880K'],
  t4: ['96', '1.1K', '14K', '602K'],
  t5: ['2.2K', '18K', '188K', '4.4M'],
};
const bookPath =
  'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253';
const nav = ['Home', 'Explore', 'Notifications', 'Messages', 'Bookmarks', 'Profile'];

const sandbox = JSON.stringify({ base, categories, timeline, library });
---

<section class="screens container" id="screens" aria-labelledby="screens-title">
  <div class="head">
    <div class="intro">
      <h2 class="section-title" id="screens-title">See it in action</h2>
      <p>Try it right here. Save any post, file it however you like, then go find it.</p>
    </div>
    <div class="seg" role="tablist" aria-label="Where you are" data-sandbox-tabs>
      <button type="button" role="tab" id="sb-tab-x" aria-controls="sb-x" aria-selected="true" data-target="x">
        <span class="tab-n" aria-hidden="true">1</span>Save on X
      </button>
      <button type="button" role="tab" id="sb-tab-dash" aria-controls="sb-dash" aria-selected="false" tabindex="-1" data-target="dash">
        <span class="tab-n" aria-hidden="true">2</span>Find it later
      </button>
    </div>
  </div>

  <div class="tour" data-sandbox={sandbox}>
    <div class="window">
      <div class="bar" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="url" data-url>x.com/home</span>
      </div>

      <div class="stage">
        <!-- The X timeline -->
        <div class="view xv" id="sb-x" role="tabpanel" aria-labelledby="sb-tab-x" data-view="x">
          <nav class="xnav" aria-hidden="true">
            {nav.map((n, i) => <span class:list={['xnav-item', { on: i === 0 }]}>{n}</span>)}
            <span class="xnav-post">Post</span>
          </nav>
          <div class="feed" data-feed-list>
            <div class="feed-tabs" aria-hidden="true"><span class="on">For you</span><span>Following</span></div>
            {
              timeline.map((p) => (
                <article class="post">
                  <img class="av" src={`${base}avatars/${p.av}.webp`} alt="" width="40" height="40" loading="lazy" />
                  <div class="post-body">
                    <p class="who">
                      <b>{p.name}</b> <span>@{p.handle} · {p.time}</span>
                    </p>
                    <p class="text">{p.text}</p>
                    <div class="actions-bar">
                      {(['reply', 'repost', 'like', 'views'] as const).map((k, i) => (
                        <span class="act" aria-hidden="true">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={icons[k]} /></svg>
                          {counts[p.id][i]}
                        </span>
                      ))}
                      <span class="act-end">
                        <span class="act" aria-hidden="true">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={icons.bookmark} /></svg>
                        </span>
                        <button type="button" class="book" data-book={p.id} aria-label="Save to XMarks" aria-expanded="false" aria-haspopup="dialog">
                          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={bookPath} /></svg>
                        </button>
                        <span class="act" aria-hidden="true">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={icons.share} /></svg>
                        </span>
                      </span>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
          <aside class="xside" aria-hidden="true">
            <span class="xsearch">Search</span>
            <div class="trend">
              <b>Trending</b>
              <span>Technology · Trending</span><b>#ReadLater</b>
              <span>Food · Trending</span><b>Focaccia dimples</b>
              <span>Trending in Tier lists</span><b>87 open tabs</b>
            </div>
          </aside>

          <div class="toast" data-toast role="status">
            <span data-toast-text>Saved</span>
            <button type="button" class="toast-view" data-toast-view>View</button>
          </div>
        </div>

        <!-- The XMarks dashboard -->
        <div class="view dv" id="sb-dash" role="tabpanel" aria-labelledby="sb-tab-dash" data-view="dash" hidden>
          <div class="dside">
            <p class="dlogo">XMarks</p>
            <div class="side-list" data-side></div>
          </div>
          <div class="dmain">
            <div class="dhead">
              <h3 data-list-title>All Bookmarks</h3>
              <label class="dsearch">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
                <span class="visually-hidden">Search your bookmarks</span>
                <input type="search" placeholder="Search by author, text, note…" autocomplete="off" data-search />
              </label>
            </div>
            <div class="dlist" data-list aria-live="polite"></div>
          </div>
        </div>

        <template data-pop-tpl>
          <div class="pop" role="dialog" aria-label="Save to XMarks">
            <div class="pop-new">
              <input type="text" placeholder="New category..." maxlength="40" autocomplete="off" aria-label="New category name" data-new-name />
              <button type="button" class="pop-add" data-add>Add</button>
            </div>
            <div class="pop-cats" data-cats></div>
            <textarea class="pop-note" placeholder="Add a note..." rows="2" aria-label="Note" data-note></textarea>
          </div>
        </template>
      </div>
    </div>

    <div class="coach">
      <div class="coach-text" aria-live="polite">
        <b data-hint-title>Save any post you like</b>
        <span data-hint-body>Click the book in a post’s action bar. You choose the category and the note.</span>
      </div>
      <div class="coach-actions">
        <button type="button" class="btn btn-accent" data-primary>Peek at the dashboard</button>
        <button type="button" class="btn btn-ghost" data-reset hidden>Start over</button>
        <a class="btn btn-ghost" href={storeUrl} target="_blank" rel="noopener noreferrer">Add to Chrome</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initSandbox } from '../scripts/sandbox';
  initSandbox();
</script>

<style>
  .screens {
    padding-top: 24px;
    padding-bottom: 112px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .intro p {
    margin: 0;
    font-size: 17px;
    color: var(--muted);
  }

  .seg {
    display: flex;
    padding: 3px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--bg-2);
  }

  .seg button {
    height: 40px;
    padding: 0 18px 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .seg button:hover {
    color: var(--text);
  }

  .seg button[aria-selected='true'] {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .tab-n {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .tour {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .window {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: var(--bg-2);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 30px 80px -20px color-mix(in srgb, var(--accent) 35%, transparent),
      0 0 120px -40px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .bar {
    position: relative;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .dots {
    position: absolute;
    left: 16px;
    display: flex;
    gap: 7px;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .url {
    min-width: 0;
    max-width: 60%;
    padding: 4px 18px;
    border-radius: 9999px;
    background: var(--bg);
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stage {
    position: relative;
    height: 560px;
    overflow: hidden;
    border-radius: 0 0 17px 17px;
    background: var(--bg);
  }

  .view {
    position: absolute;
    inset: 0;
    display: grid;
  }

  .view[hidden] {
    display: none;
  }

  p {
    margin: 0;
  }

  .stage :global(.dot) {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .stage :global(.av) {
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg-2);
  }

  /* ---- X ---- */

  .xv {
    grid-template-columns: 200px minmax(0, 600px) minmax(0, 1fr);
  }

  .xnav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 12px 16px 24px;
    font-size: 17px;
  }

  .xnav-item {
    padding: 9px 12px;
    color: var(--muted);
  }

  .xnav-item.on {
    color: var(--text);
    font-weight: 700;
  }

  .xnav-post {
    margin-top: 12px;
    padding: 10px;
    border-radius: 9999px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    text-align: center;
  }

  .feed {
    position: relative;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-inline: 1px solid var(--border);
    padding-bottom: 260px;
    scrollbar-width: thin;
  }

  .feed-tabs {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    color: var(--muted);
    font-weight: 600;
    text-align: center;
  }

  .feed-tabs span {
    padding: 14px 0;
  }

  .feed-tabs .on {
    color: var(--text);
    font-weight: 700;
    box-shadow: inset 0 -3px var(--accent);
  }

  .post {
    position: relative;
    display: flex;
    gap: 12px;
    padding: 12px 16px 6px;
    border-bottom: 1px solid var(--border);
  }

  .post-body {
    flex: 1;
    min-width: 0;
  }

  .who {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .who span {
    color: var(--muted);
  }

  .text {
    margin-top: 2px;
    overflow-wrap: anywhere;
  }

  .actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
    color: var(--muted);
    font-size: 13px;
  }

  .act {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .act-end {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .book {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    transition: background 0.15s, transform 0.2s var(--spring);
  }

  .book:hover,
  .book[aria-expanded='true'] {
    background: var(--accent-soft);
  }

  .book:active {
    transform: scale(0.9);
  }

  .book.saved svg {
    fill: currentColor;
  }

  .xside {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 12px 24px;
    min-width: 0;
  }

  .xsearch {
    padding: 9px 16px;
    border-radius: 9999px;
    background: var(--bg-2);
    color: var(--muted);
  }

  .trend {
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .trend > b:first-child {
    font-size: 19px;
    margin-bottom: 8px;
  }

  .trend span {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
  }

  /* The category menu, as the extension draws it under the button. */
  .pop {
    position: absolute;
    z-index: 3;
    top: calc(100% - 8px);
    right: 12px;
    width: min(290px, calc(100% - 24px));
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg);
    box-shadow: var(--shadow);
    font-size: 14px;
    animation: pop-in 0.18s var(--spring);
    transform-origin: top right;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  .pop-new {
    display: flex;
    gap: 8px;
    padding: 8px;
    border-bottom: 1px solid var(--border);
  }

  .pop-new input {
    flex: 1;
    min-width: 0;
    padding: 4px 6px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text);
    font: inherit;
  }

  .pop-new input:focus-visible {
    outline: 1px solid var(--border-strong);
    outline-offset: 0;
  }

  .pop-add {
    padding: 4px 14px;
    border: none;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 700;
    cursor: pointer;
  }

  .pop-cats {
    max-height: 176px;
    overflow-y: auto;
    padding: 4px 0;
    scrollbar-width: thin;
  }

  .pop-cats :global(.pop-cat) {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .pop-cats :global(.pop-cat:hover),
  .pop-cats :global(.pop-cat:focus-visible) {
    background: var(--bg-2);
    outline: none;
  }

  .pop-cats :global(.pop-cat.current)::after {
    content: 'current';
    margin-left: auto;
    color: var(--muted);
    font-size: 12px;
  }

  .pop-cats :global(.pop-cat.added) {
    animation: added 1.2s ease;
  }

  @keyframes added {
    from {
      background: var(--accent-soft);
    }
  }

  .pop-cats :global(.pop-cat-name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pop-note {
    display: block;
    width: 100%;
    padding: 10px 14px;
    border: none;
    border-top: 1px solid var(--border);
    border-radius: 0 0 14px 14px;
    background: transparent;
    color: var(--text);
    font: inherit;
    resize: none;
  }

  .pop-note:focus-visible {
    outline: none;
    background: var(--bg-2);
  }

  .toast {
    position: absolute;
    left: 50%;
    bottom: 24px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 10px 10px 18px;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 700;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transform: translate(-50%, 140%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s var(--spring), opacity 0.2s;
  }

  .toast.on {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }

  .toast-view {
    padding: 4px 14px;
    border: 1px solid currentColor;
    border-radius: 9999px;
    background: transparent;
    font-weight: 700;
    cursor: pointer;
  }

  .toast-view:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  /* ---- Dashboard ---- */

  .dv {
    grid-template-columns: 240px minmax(0, 1fr);
  }

  .dside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 14px;
    border-right: 1px solid var(--border);
    overflow-y: auto;
    min-height: 0;
  }

  .dlogo {
    padding-left: 10px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: var(--track-m);
  }

  .side-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .side-list :global(.side-head) {
    margin: 14px 10px 4px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .side-list :global(.side-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: none;
    border-radius: 10px;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .side-list :global(.side-item:hover) {
    background: var(--bg-2);
  }

  .side-list :global(.side-item[aria-pressed='true']) {
    background: var(--accent-soft);
    font-weight: 700;
  }

  .side-list :global(.side-name) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

