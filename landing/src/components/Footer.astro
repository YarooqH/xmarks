---
import Logo from './Logo.astro';
import { base, repoUrl, storeUrl } from '../site';
---

<footer class="site-footer">
  <div class="container meta">
    <span class="brand">
      <Logo size={15} />
      <span>Your bookmarks, kept in your browser · Not affiliated with X Corp.</span>
    </span>
    <span class="links">
      <a href={`${base}privacy/`}>Privacy policy</a>
      <a href={`${base}terms/`}>Terms of use</a>
      <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={storeUrl} target="_blank" rel="noopener noreferrer">Chrome Web Store</a>
    </span>
  </div>
  <div class="wordmark" aria-hidden="true">
    <span class="wordmark-fallback">XMarks</span>
    <canvas data-wordmark></canvas>
  </div>
</footer>

<script>
  import { startDotField } from '../scripts/dotfield';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-wordmark]');
  if (canvas) {
    startDotField(canvas, { mode: 'wordmark', cell: 9, text: 'XMarks', fontFamily: '"Schibsted Grotesk Variable", system-ui, sans-serif' });
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  .meta {
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 24px;
  }

  /* Tall enough to tap (44px) without changing how the row looks. */
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .links a:hover {
    color: var(--text);
  }

  .wordmark {
    position: relative;
    margin: 40px 12px 0;
    aspect-ratio: 4.3 / 1;
  }

  /* Shown only if WebGL is unavailable; the canvas paints over it otherwise. */
  .wordmark-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    font-size: 22.6vw;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.74;
    color: var(--border);
  }

  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
